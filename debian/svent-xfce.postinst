#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
  deploy() {
    home="$1"; owner="$2"
    [ -d "$home" ] || return 0
    mkdir -p "$home/.config/xfce4" "$home/.config/svent"
    python3 - "$home/.config/xfce4" <<'PY'
import shutil
import sys
from pathlib import Path
destination = Path(sys.argv[1])
def preserve_background(folder, names):
    return ["xfce4-desktop.xml"] if "xfce4-desktop.xml" in names and (destination / "xfconf/xfce-perchannel-xml/xfce4-desktop.xml").exists() else []
shutil.copytree("/etc/skel/.config/xfce4", destination,
                dirs_exist_ok=True, ignore=preserve_background)
PY
    if [ ! -e "$home/.config/xfce-mimeapps.list" ]; then
      cp -a /etc/skel/.config/xfce-mimeapps.list "$home/.config/"
      chown "$owner" "$home/.config/xfce-mimeapps.list"
    fi
    chmod 0755 "$home/.config/xfce4/xinitrc"
    mkdir -p "$home/.local/share/desktop-directories"
    cp -a /etc/skel/.local/share/desktop-directories/svent.directory "$home/.local/share/desktop-directories/"
    chown "$owner" "$home/.local" "$home/.local/share" "$home/.local/share/desktop-directories" "$home/.local/share/desktop-directories/svent.directory"
    mkdir -p "$home/.config/autostart"
    cp -a /etc/skel/.config/autostart/svent-wallpaper.desktop /etc/skel/.config/autostart/svent-xfce-panel.desktop "$home/.config/autostart/"
    chown "$owner" "$home/.config/autostart" "$home/.config/autostart/svent-wallpaper.desktop" "$home/.config/autostart/svent-xfce-panel.desktop"
    if [ ! -e "$home/.config/autostart/picom.desktop" ]; then
      cp -a /etc/skel/.config/autostart/picom.desktop "$home/.config/autostart/"
      chown "$owner" "$home/.config/autostart/picom.desktop"
    fi
    session_backup="$home/.local/state/svent-xfce/session-before-0.5.6-$(date +%s)"
    for session in "$home"/.cache/sessions/xfce4-session-*; do
      [ -f "$session" ] || continue
      mkdir -p "$session_backup"
      mv "$session" "$session_backup/"
    done
    [ ! -d "$session_backup" ] || chown -R "$owner" "$session_backup"
    [ -f "$home/.config/svent/wallpaper.choice" ] || echo "currents-dark" > "$home/.config/svent/wallpaper.choice"
    cp -a /etc/skel/.Xresources "$home/.Xresources"
    chown "$owner" "$home/.Xresources" 2>/dev/null || true
    env -u DISPLAY python3 /usr/share/svent/xfce-panel/prepare-desktop.py --config "$home/.config"
    mkdir -p "$home/.config/gtk-3.0"
    css="$home/.config/gtk-3.0/gtk.css"
    python3 - "$css" <<'PY'
import re
import sys
from pathlib import Path
p = Path(sys.argv[1])
s = p.read_text() if p.exists() else ""
s = re.sub(r"/\* BEGIN Z1ROV DARK PANEL \*/.*?/\* END Z1ROV DARK PANEL \*/\n?", "", s, flags=re.S)
line = '@import url("../xfce4/panel/svent-panel.css");'
s = s.replace(line, "")
s = line + "\n" + s.lstrip()
p.write_text(s, encoding="utf-8")
PY
    chown "$owner" "$home/.config/gtk-3.0" "$css" 2>/dev/null || true
    chown -R "$owner" "$home/.config/xfce4" "$home/.config/svent" 2>/dev/null || true
    rm -f "$home/.local/state/svent-xfce-panel.done" 2>/dev/null || true
  }
  deploy /root "root:root"
  for home in /home/*; do
    [ -d "$home" ] || continue
    deploy "$home" "$(basename "$home"):$(basename "$home")"
  done
fi
#DEBHELPER#
